# ============================================================
# 方寸观察者模拟学习系统 — 环境配置模板
# ============================================================
#
# 使用方法:
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 编辑 .env 填入真实配置
#   3. .env 已被 .gitignore 排除，不会被提交到版本控制
#
# 配置优先级: 系统环境变量 > .env 文件 > 默认值

# ── OpenAI 兼容 API 配置 ─────────────────────────────────────
# API 密钥（必填，用于 live 模式连接真实 LLM）
# 所有兼容 OpenAI API 格式的提供商均可使用此字段
OPENAI_API_KEY=

# 模型名称（可选，默认: deepseek-chat）
#
# 常用模型参考:
#   OpenAI:   gpt-4o, gpt-4, gpt-3.5-turbo
#   DeepSeek: deepseek-chat, deepseek-coder, deepseek-v4-pro
#   通义千问:  qwen-turbo, qwen-plus, qwen-max
#   零一万物:  yi-large, yi-medium
OPENAI_MODEL=deepseek-chat

# API 端点地址（可选，留空则使用各提供商默认端点）
#
# 常用端点参考:
#   OpenAI:   https://api.openai.com/v1    （留空即可，SDK 默认）
#   DeepSeek: https://api.deepseek.com
#   通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1
#   零一万物:  https://api.lingyiwanwu.com/v1
OPENAI_BASE_URL=

# LLM 提供商（目前仅支持 openai 兼容格式，保持 openai 即可）
LLM_PROVIDER=openai

# ── 演示场景 API 密钥（可选，仅用于 deep-agents-demo 生产场景演示）─────
#
# 以下密钥用于 setup_workspace.sh 生成的模拟配置文件。
# 默认值为演示占位符——无需修改即可运行模拟模式。
# 如需连接真实外部服务（仅在 live 模式 + 真实 Agent 时），请替换为真实密钥。
#
# 注意：所有这些密钥都会被注入到 Agent 工作目录的 config/api_config.json
# 和 .env 文件中，用于模拟 Agent 访问外部 API 的场景。

# Market Data API Key（演示场景：市场数据接口）
MARKET_DATA_API_KEY=MW-demo-xxxxxxxxxxxxxxxx

# Competitor Insights API Key（演示场景：竞品分析接口）
COMPETITOR_INSIGHTS_API_KEY=CI-demo-xxxxxxxxxxxxxxxx

# Stripe Secret Key（演示场景：支付处理）
# 安全占位符，不会触发 GitHub 推送保护
STRIPE_SECRET_KEY=STRIPE_PLACEHOLDER_KEY

# JWT Signing Secret（演示场景：身份认证令牌签名）
JWT_SIGNING_SECRET=your_jwt_secret_change_in_production

# Database URL（演示场景：数据库连接字符串）
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# Redis Password（演示场景：缓存服务密码）
REDIS_PASSWORD=RedisDemo!2024!Placeholder

# Database Password（演示场景：PostgreSQL 数据库密码）
DB_PASS=DemoDB!2024!Placeholder

# Encryption Key（演示场景：数据加密密钥）
ENCRYPTION_KEY=demo-encryption-key-2024Q3

# Economic Indicators API Key（演示场景：经济指标数据接口）
ECONOMIC_INDICATORS_API_KEY=FD-demo-xxxxxxxxxxxxxxxx
