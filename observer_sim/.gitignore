# ============================================================
# observer_sim/.gitignore — 子目录补充规则
# 主规则见 ../../.gitignore（项目根目录）
# ============================================================

# === Python（子目录相对路径） ===
__pycache__/
*.py[cod]
*.egg-info/

# === pytest ===
.pytest_cache/

# === 项目输出目录 ===
output/

# === 临时测试输出 ===
demo_output.txt
mode_test.txt
*.log

# === eBPF 编译产物 ===
ebpf/vmlinux.h
ebpf/*.o
ebpf/*.llc

# === C++ 探针编译产物 ===
cpp_probe/build/

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === 操作系统 ===
.DS_Store
Thumbs.db
# ============================================================
# observer_sim/.gitignore — 方寸观察者模拟学习系统
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# === pytest ===
.pytest_cache/
.pytest_cache/**

# === 项目输出目录（运行时动态生成，不纳入版本控制） ===
# 报告、审计日志、证据文件、基线、图谱、单元测试输出
output/

# === 临时测试输出文件 ===
demo_output.txt
mode_test.txt
*.log

# === C++ 探针编译产物 ===
cpp_probe/build/

# === eBPF 编译产物 (Phase 3) ===
ebpf/vmlinux.h
ebpf/*.o
ebpf/*.llc

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 虚拟环境 ===
.venv/
venv/
env/
