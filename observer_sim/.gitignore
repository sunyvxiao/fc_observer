# ============================================================
# observer_sim/.gitignore — 子目录补充规则
# 主规则见 ../../.gitignore（项目根目录，唯一主文件）
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# === pytest ===
.pytest_cache/

# === 项目输出目录（报告/审计/证据/基线/图谱，运行时生成） ===
output/

# === 临时测试输出 ===
demo_output.txt
mode_test.txt
*.log

# === 录制数据（运行时产物） ===
records/

# === eBPF 编译产物 ===
ebpf/vmlinux.h
ebpf/*.o
ebpf/*.llc

# === C++ 探针编译产物 ===
cpp_probe/build/

# === 历史备份归档（.backup_YYYYMMDD/，本地保留不入库） ===
.backup_*/

# === IDE / 操作系统 / 虚拟环境（兜底，主文件已有） ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.venv/
venv/
env/
