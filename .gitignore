# ============================================================
# 项目根目录 .gitignore — 方寸观察者模拟学习系统
# 整合根目录 + observer_sim/ 双 .gitignore，以本文件为唯一主文件
# ============================================================

# === IDE / 编辑器 ===
.qoder/
.vscode/
.idea/
*.swp
*.swo
*~

# === Python 全局 ===
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.pyo
.pytest_cache/
.pytest_cache/**
.pytest_basetemp/
.pytest_basetemp*/
observer_sim/.pytest_basetemp/
observer_sim/.pytest_basetemp*/
dist/
build/
.eggs/

# === 虚拟环境 ===
.venv/
venv/
env/

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 运行时输出 ===
observer_sim/output/
# 测试留痕归档（对照测试批次归档、历史审计留痕，本地保留不入库）
observer_sim/output_backup/
*.log
demo_output.txt
mode_test.txt

# === eBPF 编译产物 ===
observer_sim/ebpf/vmlinux.h
observer_sim/ebpf/*.o
observer_sim/ebpf/*.llc

# === C++ 构建产物 ===
observer_sim/cpp_probe/build/

# === 录制数据（运行时产物） ===
records/

# === 环境配置文件（含敏感信息） ===
.env

# === Agent 演示工作目录（含生成的模拟数据） ===
deep-agents-demo/workspace/

# === 监测演示运行时目录 ===
.monitoring/

# === 高权限测试脚本和日志 ===
sudo_test/

# === 截图文件 ===
assets/screenshots/

# === 临时文件 ===
*.tmp
*.bak
*.bak-*

# === 历史备份归档（.backup_YYYYMMDD/，本地保留不入库） ===
.backup_*/

# === 临时脚本（tmp 前缀测试残留） ===
observer_sim/tmp*.py
# === 临时验证/分析脚本（下划线前缀，用毕即删，不入库） ===
_verify_*.py
_smoke_*.py
_p1_*.py
_check_*.py
observer_sim/_verify_*.py
observer_sim/_smoke_*.py
observer_sim/_p1_*.py
observer_sim/_check_*.py
# === 剪贴板/OCR 验证残留 ===
_clipcheck.txt
clip_verify.txt
ocr_result.txt
ocr_run.ps1

# === WorkBuddy 验证辅助：剪贴板临时转储（含运行时内容） ===
WorkBuddy降级监测适配/tools/clipboard_dump.txt

# === SSH 密钥与凭证（严禁提交） ===
*.pem
*.key
*.pfx
*_rsa
*_ed25519
fco
fco.pub

# === 编辑器工具缓存 ===
.lingma/

# === Qoder CN 端到端测试运行时产物（不入库） ===
QoderCN监测端到端测试/验收截图_*.png
QoderCN监测端到端测试/e2e_result_*.json
