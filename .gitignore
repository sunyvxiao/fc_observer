# ============================================================
# 项目根目录 .gitignore — projact3
# ============================================================

# === IDE / 编辑器 ===
.qoder/
.vscode/
.idea/

# === Python 全局 ===
__pycache__/
*.py[cod]
*.egg-info/
*.pyo
.pytest_cache/

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 运行时输出 ===
observer_sim/output/
*.log

# === 高权限测试脚本和日志 ===
sudo_test/

# === 截图文件 ===
测试图片/

# === C++ 构建产物 ===
observer_sim/cpp_probe/build/

# === 临时文件 ===
*.tmp
*.bak
*.swp
*~
